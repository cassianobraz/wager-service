# Copie para .env para execuções locais (sem docker-compose) do cmd/api.
# Todos os valores abaixo são padrões locais/dev -- nenhum deles é um
# segredo real, e nenhum deve ser reutilizado fora de uma máquina local.
# internal/infra/config/config.go é o único lugar que lê essas variáveis.

HTTP_ADDR=:8080

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wager
POSTGRES_PASSWORD=wager
POSTGRES_DB=wager
POSTGRES_SSLMODE=disable

# Substituição: o RabbitMQ substitui o AWS SQS/LocalStack sugerido pelo desafio.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=wager.events
RABBITMQ_QUEUE=wager.transactions
RABBITMQ_ROUTING_KEY=wager.transaction.#
RABBITMQ_RETRY_EXCHANGE=wager.transactions.retry
RABBITMQ_RETRY_QUEUE=wager.transactions.retry
RABBITMQ_DLX=wager.transactions.dlx
RABBITMQ_DLQ=wager.transactions.dlq
RABBITMQ_CONSUMER_NAME=wager-consumer
RABBITMQ_PREFETCH_COUNT=32
RABBITMQ_MAX_RETRIES=5

# Substituição: o Keycloak implementa o requisito de autenticação
KEYCLOAK_ISSUER=http://localhost:8081/realms/wager
KEYCLOAK_JWKS_URL=http://localhost:8081/realms/wager/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=
KEYCLOAK_PROVIDER_CLAIM=azp
